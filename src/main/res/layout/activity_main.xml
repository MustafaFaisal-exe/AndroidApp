<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBg">

    <!-- ═══════════════════════════════════════════════════════════
         CAMERA PREVIEW — fills full screen
         ═══════════════════════════════════════════════════════════ -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:scaleType="fillCenter" />

    <!-- PROCESSED FRAME — shown instead of preview when active -->
    <ImageView
        android:id="@+id/processedView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:scaleType="fitCenter"
        android:visibility="gone"
        android:background="@android:color/transparent" />

    <!-- YOLO bounding boxes drawn on top of processed frame -->
    <com.example.cameraapp.DetectionOverlay
        android:id="@+id/detectionOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:visibility="gone" />

    <!-- ═══════════════════════════════════════════════════════════
         TOP HUD — app title, mode badge, FPS
         ═══════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/topHud"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="48dp"
        android:paddingBottom="14dp"
        android:background="@color/colorHudBg"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- App icon dot + title -->
        <View
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/dot_accent"
            android:layout_marginEnd="10dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="TruckVision AI"
            android:textColor="@color/colorText"
            android:textSize="17sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:layout_weight="1" />

        <!-- Active mode badge -->
        <TextView
            android:id="@+id/modeBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="bc+yolo"
            android:textColor="@color/colorPrimary"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:background="@drawable/badge_bg"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:layout_marginEnd="12dp" />

        <!-- Load Status Badge -->
        <TextView
            android:id="@+id/loadStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="UNKNOWN"
            android:textColor="@android:color/white"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:background="@drawable/badge_bg"
            android:backgroundTint="@color/colorTextMuted"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:layout_marginEnd="12dp" />

        <!-- FPS counter -->
        <TextView
            android:id="@+id/fpsText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-- fps"
            android:textColor="@color/colorAccent"
            android:textSize="13sp"
            android:fontFamily="monospace" />

    </LinearLayout>

    <TextView
        android:id="@+id/truckConfidenceText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/badge_bg"
        android:fontFamily="monospace"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:text=""
        android:textColor="@color/colorText"
        android:textSize="12sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/stabilityProgressText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/badge_bg"
        android:backgroundTint="#80000000"
        android:fontFamily="monospace"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:text="Hold steady... 0/10"
        android:textColor="@color/colorAccent"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/truckConfidenceText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Analyzing Overlay -->
    <LinearLayout
        android:id="@+id/analyzingOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/badge_bg"
        android:backgroundTint="#CC000000"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminateTint="@color/colorPrimary"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Analyzing..."
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════════════
         BOTTOM CONTROL PANEL
         ═══════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/colorHudBg"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Divider line at top of panel -->
        <View
            android:layout_width="40dp"
            android:layout_height="3dp"
            android:background="@color/colorDivider"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="14dp" />

        <!-- ─── TASK MODE ROW ─── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <TextView
                android:text="TASK"
                android:textColor="@color/colorTextMuted"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:letterSpacing="0.15"
                android:layout_width="64dp"
                android:layout_height="wrap_content" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/taskModeGroup"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNight"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="Night"
                    android:textSize="12sp"
                    android:textColor="@color/colorText"
                    app:strokeColor="@color/colorDivider" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFront"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="Front"
                    android:textSize="12sp"
                    android:textColor="@color/colorText"
                    app:strokeColor="@color/colorDivider" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFullEmpty"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="Empty Detection"
                    android:textSize="11sp"
                    android:textColor="@color/colorText"
                    android:textAllCaps="false"
                    android:padding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:strokeColor="@color/colorDivider" />

            </com.google.android.material.button.MaterialButtonToggleGroup>
        </LinearLayout>

        <!-- ─── YOLO TOGGLE ROW ─── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <TextView
                android:text="YOLO"
                android:textColor="@color/colorTextMuted"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:letterSpacing="0.15"
                android:layout_width="64dp"
                android:layout_height="wrap_content" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/yoloToggleGroup"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnYoloOn"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="ON"
                    android:textSize="12sp"
                    android:textColor="@color/colorText"
                    app:strokeColor="@color/colorDivider" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnYoloOff"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="OFF"
                    android:textSize="12sp"
                    android:textColor="@color/colorText"
                    app:strokeColor="@color/colorDivider" />

            </com.google.android.material.button.MaterialButtonToggleGroup>
        </LinearLayout>

        <!-- ─── DENOISE MODE ROW ─── -->
        <LinearLayout
            android:id="@+id/denoiseRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp"
            android:visibility="gone">

            <TextView
                android:text="DENOISE"
                android:textColor="@color/colorTextMuted"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:letterSpacing="0.15"
                android:layout_width="64dp"
                android:layout_height="wrap_content" />

            <TextView
                android:text="Box Blur Active"
                android:textColor="@color/colorText"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- ─── STATUS BAR ─── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Status dot -->
            <View
                android:id="@+id/statusDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/dot_status"
                android:layout_marginEnd="8dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ready"
                    android:textColor="@color/colorTextMuted"
                    android:textSize="11sp"
                    android:fontFamily="monospace" />

                <TextView
                    android:id="@+id/debugMetricsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/colorTextMuted"
                    android:textSize="9sp"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <ImageView
                android:id="@+id/heatmapView"
                android:layout_width="80dp"
                android:layout_height="60dp"
                android:background="@color/colorBg"
                android:scaleType="fitCenter"
                android:layout_marginStart="8dp" />

        </LinearLayout>

        <!-- Retry Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/retryButton"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="16dp"
            android:text="RETRY / SCAN AGAIN"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="8dp"
            android:visibility="gone"
            android:backgroundTint="@color/colorRear" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
